[manifest]
name = bpftool

[git]
repo_url = https://github.com/libbpf/bpftool.git
rev = v7.4.0
branch = v7.4.0

# BPF only builds on Linux, so make it a NOP on other platforms.
[build.not(os=linux)]
builder = nop

[build.os=linux]
builder = make
subdir = src
patchfile = bpftool_install_to_bin.patch

# bpftool's own BPF skeletons (pid_iter, profiler) need llvm-strip, which is
# not always installed alongside clang. Consumers only need `gen skeleton` and
# `btf dump`, so skip them. Install must match, or make rebuilds with them.
[make.build_args]
feature-clang-bpf-co-re=0

[make.install_args]
feature-clang-bpf-co-re=0
install-bin

[dependencies]
libelf
zlib
