[manifest]
name = glean
fbsource_path = fbcode/glean
shipit_project = facebookincubator/Glean
use_shipit = true

[shipit.pathmap]
# These are only used by target determinator to trigger builds, the
# real path mappings are in the ShipIt config.
fbcode/glean = glean
fbcode/common/hs = hsthrift

[subprojects]
hsthrift = hsthrift

[dependencies]
cabal
ghc
gflags
glog
folly
rocksdb
xxhash
llvm19
clang19
re2
# cabal.project sets `tests: True`, so the BinaryTest suite's
# `pkgconfig-depends: gtest_main` must resolve even for a plain build.
googletest
# thrift-http's streaming-commons, warp and http-client link zlib through the
# Hackage zlib package.
zlib
# regex-pcre finds PCRE1 through `pkgconfig-depends: libpcre`.
pcre

[build]
builder = make

[make.build_args]
setup-folly
setup-folly-version
cabal-update
all
glean-hie
glass
glean-clang
EXTRA_GHC_OPTS=-j4 +RTS -A32m -n4m -RTS
CABAL_CONFIG_FLAGS=-f-hack-tests -f-typescript-tests -f-python-tests -f-dotnet-tests -f-go-tests -f-rust-tests -f-java-lsif-tests -f-flow-tests -f-bundled-folly

[make.install_args]
install

[make.test_args]
test
EXTRA_GHC_OPTS=-j4 +RTS -A32m -n4m -RTS
CABAL_CONFIG_FLAGS=-f-hack-tests -f-typescript-tests -f-python-tests -f-dotnet-tests -f-go-tests -f-rust-tests -f-java-lsif-tests -f-flow-tests -f-bundled-folly
