[manifest]
name = katran
fbsource_path = fbcode/katran
shipit_project = katran
shipit_fbcode_builder = true
shipit_fbcode_builder_layout = tool

[git]
repo_url = https://github.com/facebookincubator/katran.git

[build.not(os=linux)]
builder = nop

[build.os=linux]
builder = cmake
subdir = .

# getdeps has never built the BPF programs, and its builders may lack clang.
[cmake.defines]
KATRAN_BUILD_BPF=OFF
KATRAN_BUILD_KDE=ON

[cmake.defines.test=on]
BUILD_TESTS=ON

[cmake.defines.test=off]
BUILD_TESTS=OFF

[debs]
clang
llvm

[rpms]
clang
llvm

[dependencies]
bpftool
CLI11
fb303
fbthrift
fizz
folly
fmt
googletest
libbpf
libmnl
opentelemetry-cpp
zlib

[shipit.pathmap]
fbcode/katran/public_root = .
fbcode/katran = katran

[shipit.strip]
^fbcode/katran/facebook
^fbcode/katran/OSS_SYNC
