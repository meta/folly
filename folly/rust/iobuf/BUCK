load("@fbsource//tools/build_defs:default_platform_defs.bzl", "ANDROID", "APPLE", "CXX", "FBCODE", "WINDOWS")
load("@fbsource//tools/build_defs:fb_native_wrapper.bzl", "fb_native")
load("@fbsource//tools/build_defs:fb_xplat_cxx_library.bzl", "fb_xplat_cxx_library")
load("@fbsource//tools/build_defs:fb_xplat_rust_library.bzl", "fb_xplat_rust_library")
load("@fbsource//tools/build_defs:fbsource_utils.bzl", "is_xplat")
load("@fbsource//tools/build_defs:rust_bindgen_library.bzl", "rust_bindgen_library")
load("@fbsource//tools/build_defs/dirsync:dirsync_redirect.bzl", "dirsync_redirect")
load("@fbsource//tools/build_defs/dirsync:fb_dirsync_cpp_library.bzl", "fb_dirsync_cpp_library")

oncall("rust_libraries")

rust_bindgen_library(
    name = "iobuf-sys",
    allowlist_funcs = [
        "facebook::rust::.*",
    ],
    allowlist_types = [
        "folly::IOBuf",
        "facebook::rust::.*",
    ],
    allowlist_vars = [
        "facebook::rust::.*",
    ],
    blocklist_types = [
        # These seems to come from type_traits / make_signed via fbvector
        "folly::fbvector.*",
        "__type",
        "type_",
    ],
    cpp_deps = [":iobuf-ffi"],
    cxx_namespaces = True,
    generate = ("types", "vars", "functions"),
    header = "iobuf.h",
    opaque_types = [
        "std::.*",
        "folly::fbstring.*",
    ],
    platforms = [
        CXX,
        APPLE,
        FBCODE,
        WINDOWS,
    ]
    + ([ANDROID] if is_xplat() else []),
    src_includes = ["iobuf_sys.rs"],
    visibility = [],
)

fb_dirsync_cpp_library(
    name = "iobuf-ffi",
    srcs = ["iobuf.cpp"],
    headers = ["iobuf.h"],
    platforms = [
        CXX,
        APPLE,
        WINDOWS,
    ]
    + ([ANDROID] if is_xplat() else []),
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
    xplat_impl = fb_xplat_cxx_library,
    exported_deps = [
        "//folly/io:iobuf",
    ],
)

fb_native.alias(
    name = "_iobuf-ffiFbcode",
    actual = ":iobuf-ffi",
    visibility = [
        "fbcode//folly/rust/iobuf/...",
        "fbsource//xplat/folly/rust/iobuf/...",
    ],
) if is_xplat() else None

fb_native.alias(
    name = "iobuf_actual",
    actual = ":iobuf",
)

fb_xplat_rust_library(
    name = "iobuf",
    srcs = glob(["src/*.rs"]),
    cpp_deps = [":iobuf-ffi"],
    crate = "iobuf",
    crate_root = "src/lib.rs",
    cxx_bridge = "src/lib.rs",
    platforms = [
        CXX,
        APPLE,
        WINDOWS,
    ]
    + ([ANDROID] if is_xplat() else []),
    test_deps = [
        "fbsource//third-party/rust:quickcheck",
        "fbsource//xplat/thrift/lib/rust/src/dep_tests:test_if-rust",
    ],
    visibility = ["PUBLIC"],
    xplat_preexisting_target_flavors = [FBCODE],
    deps = [
        "fbsource//third-party/rust:bytes",
        "fbsource//third-party/rust:cxx",
        "fbsource//third-party/rust:memmap2",
        "fbsource//xplat/thrift/lib/rust:fbthrift",
        ":iobuf-sys",
    ],
)

dirsync_redirect.create_alias(
    "iobuf_dirsync",
    dirsync_redirect.read(),
    actual = ":iobuf",
    skip_suffixed_aliases = True,
)

fb_native.alias(
    name = "iobufFbcode",
    actual = ":iobuf",
    visibility = [
        "fbcode//folly/rust/iobuf/...",
        "fbsource//xplat/folly/rust/iobuf/...",
    ],
) if is_xplat() else None
