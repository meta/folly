fb_dirsync_cpp_library(
    name = "filesystem",
    srcs = ["Filesystem.cpp"],
    headers = ["Filesystem.h"],
    use_raw_headers = True,
    # stdc++fs was needed for GCC <9; all active platform010 builds use GCC 11.x
    # where <filesystem> is part of libstdc++ itself.  The centos8 redhat
    # toolchain (libstdc++ 8.5.0) still needs it, but no centos8 target is known
    # to depend on this target.  The prebuilt libstdc++fs.a is also non-PIC,
    # which breaks shared-library links (T267176152).
    exported_deps = [],
)

fb_dirsync_cpp_library(
    name = "fmt_compile",
    headers = ["FmtCompile.h"],
    apple_sdks = (IOS, APPLETVOS, MACOSX, WATCHOS),
    use_raw_headers = True,
    exported_deps = [
        "fbsource//third-party/fmt:fmt",
    ],
)

# because certain arvr builds duplicate gflags and do this in an exec dependency, we need this until we fix that behavior.
_GFLAGS_DEPS = [
    "fbsource//arvr/third-party/gflags:gflags" if is_arvr_mode() else "fbsource//third-party/gflags:gflags",
]

fb_dirsync_cpp_library(
    # @autodeps-skip
    name = "gflags",
    srcs = select({
        "DEFAULT": [],
        "ovr_config//runtime:fbcode": ["GFlags.cpp"],
    }),
    headers = ["GFlags.h"],
    apple_sdks = (IOS, APPLETVOS, MACOSX, WATCHOS),
    compiler_flags = ["-fno-omit-frame-pointer"],
    exported_preprocessor_flags = select({
        "DEFAULT": ["-DFOLLY_HAVE_LIBGFLAGS=1"] if should_enable_gflags() else ["-DFOLLY_HAVE_LIBGFLAGS=0"],
        "fbsource//xplat/folly/buck_config:folly-gflags-enabled": ["-DFOLLY_HAVE_LIBGFLAGS=1"],
        "ovr_config//os:linux": ["-DFOLLY_HAVE_LIBGFLAGS=1"],
        "ovr_config//os:macos": ["-DFOLLY_HAVE_LIBGFLAGS=1"],
        "ovr_config//os:windows": ["-DFOLLY_HAVE_LIBGFLAGS=1"],
        # In some cases, fbandroid suffixed rules can build with the fbcode platforms.
        "ovr_config//runtime:fbcode": ["-DFOLLY_HAVE_LIBGFLAGS=1"],
    }),
    use_raw_headers = True,
    exported_deps = [":config"]
    + selects.with_or({
        "DEFAULT": _GFLAGS_DEPS if should_enable_gflags() else [],
        (
            "fbsource//xplat/folly/buck_config:folly-gflags-enabled",
            "ovr_config//os:linux",
            "ovr_config//os:macos",
            "ovr_config//os:windows",
            "ovr_config//runtime:fbcode",
        ): _GFLAGS_DEPS,
    }),
)

