        "//folly/external/fast-crc32:avx512_crc32c_v8s3x4",  # @manual
        "//folly/external/fast-crc32:neon_crc32c_v3s4x2e_v2",  # @manual
        "//folly/external/fast-crc32:neon_eor3_crc32_v8s2x4e_s1x2",  # @manual
        "//folly/external/fast-crc32:neon_eor3_crc32c_v8s2x4e_s2x1",  # @manual
