fb_dirsync_rule(
    name = "fatal_test",
    srcs = ["fatal_test.py"],
    env = {
        "FOLLY_FATAL_HELPER": "$(location fbcode//folly/logging/test/helpers:fatal_helper)",
    },
    fbcode_rule = python_unittest,
)

fb_dirsync_rule(
    name = "log_after_main",
    srcs = ["log_after_main.py"],
    env = {
        "FOLLY_LOG_AFTER_MAIN_HELPER": "$(location fbcode//folly/logging/test/helpers:log_after_main)",
        "FOLLY_LOG_AFTER_MAIN_NO_INIT_HELPER": "$(location fbcode//folly/logging/test/helpers:log_after_main_no_init)",
    },
    fbcode_rule = python_unittest,
)

