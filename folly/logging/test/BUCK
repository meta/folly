fb_dirsync_cpp_library(
    name = "xlog_test_lib",
    srcs = [
        "XlogFile1.cpp",
        "XlogFile2.cpp",
    ],
    headers = [
        "XlogHeader1.h",
        "XlogHeader2.h",
    ],
    # Override the fbcode default for source paths and mapped header paths.
    compiler_flags = [
        "-UFOLLY_XLOG_STRIP_PREFIXES",
        '-DFOLLY_XLOG_STRIP_PREFIXES="fbcode:fbsource:xplat"',
    ],
    exported_deps = [
        "//folly:range",
        "//folly/logging:logging",
    ],
)

