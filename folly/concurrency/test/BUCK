load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")

oncall("fbcode_entropy_wardens_folly")

# StressTestReclamation spins up thousands of real threads to stress hazptr
# node reclamation; TSAN's per-access instrumentation overhead pushes that
# past the CI timeout. The same reclamation code path is already covered
# under TSAN by concurrent_hash_map_test (EraseStressTest,
# TryEmplaceEraseStressTest, ConcurrentInsertClear) and by hazptr_test.
_TSAN_INCOMPATIBLE_LABELS = ci.labels(
    ci.remove(
        ci.linux(ci.mode("fbcode//mode/dev-tsan")),
        ci.linux(ci.mode("fbcode//mode/opt-tsan")),
    ),
)

_F14_FALLBACK_CI_CONFIG = ci.map(
    ci.buckconfig("cxx.extra_cxxflags", "-DFOLLY_F14_FORCE_FALLBACK=1"),
)
_F14_FALLBACK_CI_LABELS = ci.labels(_F14_FALLBACK_CI_CONFIG)
_TSAN_INCOMPATIBLE_F14_FALLBACK_CI_LABELS = ci.labels(
    ci.remove(
        ci.linux(ci.mode("fbcode//mode/dev-tsan")),
        ci.linux(ci.mode("fbcode//mode/opt-tsan")),
    ),
    _F14_FALLBACK_CI_CONFIG,
)

