load("@fbcode_macros//build_defs:python_library.bzl", "python_library")
load("@fbcode_macros//build_defs:python_unittest.bzl", "python_unittest")
load("@fbsource//tools/build_defs:fbsource_utils.bzl", "is_xplat")
load("@fbsource//tools/build_defs/dirsync:fb_dirsync_rule.bzl", "fb_dirsync_rule")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")

oncall("fbcode_entropy_wardens_folly")

fb_dirsync_rule(
    name = "run_scenario_lib",
    srcs = [
        "checkpoint.py",
        "checkpoint_accounting.py",
        "compress_checkpoint_outputs.py",
        "debrief_tables.py",
        "directory_snapshot.py",
        "run_scenario.py",
    ],
    fbcode_rule = python_library,
    resources = {
        "fbsource//xplat/folly/agents/scripts:apply_diffs": "folly/agents/scripts/apply_diffs",
    },
    deps = ["fbsource//xplat/folly/agents/scripts:isolated_agent_lib" if is_xplat() else "//folly/agents/scripts:isolated_agent_lib"],
)

fb_dirsync_rule(
    name = "directory_snapshot_test",
    srcs = ["test_directory_snapshot.py"],
    fbcode_rule = python_unittest,
    network_access = network_access_utils.none(),
    deps = [":run_scenario_lib"],
)

